BOILERPLATE_PRIMARY.ENV="local"

BOILERPLATE_SERVER.PORT="8080"
BOILERPLATE_SERVER.READ_TIMEOUT="30"
BOILERPLATE_SERVER.WRITE_TIMEOUT="30"
BOILERPLATE_SERVER.IDLE_TIMEOUT="60"
BOILERPLATE_SERVER.CORS_ALLOWED_ORIGINS="http://localhost:3000"
BOILERPLATE_SERVER.SHUTDOWN_TIMEOUT="30"
BOILERPLATE_SERVER.DRAIN_TIMEOUT="15"

# Rate Limiting (Redis-backed sliding window, disabled by default for local dev)
BOILERPLATE_SERVER.RATE_LIMIT.ENABLED="false"
BOILERPLATE_SERVER.RATE_LIMIT.WINDOW="60s"
BOILERPLATE_SERVER.RATE_LIMIT.MAX="100"
BOILERPLATE_SERVER.RATE_LIMIT.KEY_PREFIX="ratelimit:"
BOILERPLATE_SERVER.RATE_LIMIT.BY_USER="false"

# Idempotency (Redis-backed, disabled by default for local dev)
BOILERPLATE_SERVER.IDEMPOTENCY.ENABLED="false"
BOILERPLATE_SERVER.IDEMPOTENCY.TTL="24h"
BOILERPLATE_SERVER.IDEMPOTENCY.KEY_PREFIX="idemp:"

BOILERPLATE_DATABASE.HOST="localhost"
BOILERPLATE_DATABASE.PORT="5432"
BOILERPLATE_DATABASE.USER="postgres"
BOILERPLATE_DATABASE.PASSWORD="postgres"
BOILERPLATE_DATABASE.NAME="boilerplate"
BOILERPLATE_DATABASE.SSL_MODE="disable"
BOILERPLATE_DATABASE.MAX_OPEN_CONNS="25"
BOILERPLATE_DATABASE.MAX_IDLE_CONNS="25"
BOILERPLATE_DATABASE.CONN_MAX_LIFETIME="300"
BOILERPLATE_DATABASE.CONN_MAX_IDLE_TIME="300"
BOILERPLATE_DATABASE.AUTO_MIGRATE="false"

# Single-string DSN for CLI tooling (tern via `task migrations:up`).
# The app builds its own DSN from the fields above; koanf ignores this key.
BOILERPLATE_DB_DSN="postgres://postgres:postgres@localhost:5432/boilerplate?sslmode=disable"

BOILERPLATE_AUTH.SECRET_KEY="secret"

BOILERPLATE_INTEGRATION.RESEND_API_KEY="resend_key"

# ============================================================================
# REDIS CONFIGURATION
# ============================================================================

# Connection
BOILERPLATE_REDIS.ADDRESS="localhost:6379"
# Mode: single | cluster | sentinel
BOILERPLATE_REDIS.MODE="single"
BOILERPLATE_REDIS.USERNAME=""
BOILERPLATE_REDIS.PASSWORD=""
BOILERPLATE_REDIS.DB="0"

# TLS (required for Redis Cloud, Upstash, ElastiCache in-transit, etc.)
BOILERPLATE_REDIS.TLS_ENABLED="false"
BOILERPLATE_REDIS.TLS_SKIP_VERIFY="false"

# Connection pool
BOILERPLATE_REDIS.POOL_SIZE="10"
BOILERPLATE_REDIS.MIN_IDLE_CONNS="5"

# Timeouts
BOILERPLATE_REDIS.DIAL_TIMEOUT="5s"
BOILERPLATE_REDIS.READ_TIMEOUT="3s"
BOILERPLATE_REDIS.WRITE_TIMEOUT="3s"

# Retry
BOILERPLATE_REDIS.MAX_RETRIES="3"
BOILERPLATE_REDIS.MIN_RETRY_BACKOFF="100ms"
BOILERPLATE_REDIS.MAX_RETRY_BACKOFF="3s"

# Cache key prefix and default TTL
BOILERPLATE_REDIS.KEY_PREFIX=""
BOILERPLATE_REDIS.DEFAULT_TTL="5m"

# ============================================================================
# OBSERVABILITY CONFIGURATION
# ============================================================================

# Service Identity
BOILERPLATE_OBSERVABILITY.SERVICE_NAME="boilerplate"
BOILERPLATE_OBSERVABILITY.ENVIRONMENT="local"

# ============================================================================
# LOGGING CONFIGURATION
# ============================================================================

# Basic Logging Settings
BOILERPLATE_OBSERVABILITY.LOGGING.LEVEL="debug"
BOILERPLATE_OBSERVABILITY.LOGGING.FORMAT="console"
BOILERPLATE_OBSERVABILITY.LOGGING.SLOW_QUERY_THRESHOLD="100ms"

# ============================================================================
# OPENTELEMETRY TRACING
# ============================================================================

BOILERPLATE_OBSERVABILITY.TRACING.ENABLED="false"
BOILERPLATE_OBSERVABILITY.TRACING.ENDPOINT="localhost:4317"
BOILERPLATE_OBSERVABILITY.TRACING.SAMPLE_RATE="1.0"
BOILERPLATE_OBSERVABILITY.TRACING.INSECURE="true"

# ============================================================================
# OPENTELEMETRY METRICS
# ============================================================================

BOILERPLATE_OBSERVABILITY.METRICS.ENABLED="false"
BOILERPLATE_OBSERVABILITY.METRICS.ENDPOINT="localhost:4317"
BOILERPLATE_OBSERVABILITY.METRICS.INTERVAL="15s"
BOILERPLATE_OBSERVABILITY.METRICS.INSECURE="true"

# ============================================================================
# SENTRY CONFIGURATION
# ============================================================================

# DSN for the "boilerplate" Sentry project. Empty DSN disables the SDK entirely.
BOILERPLATE_OBSERVABILITY.SENTRY.DSN=""
# Matches BOILERPLATE_PRIMARY.ENV, so events are tagged consistently
# across every environment the service runs in.
BOILERPLATE_OBSERVABILITY.SENTRY.ENVIRONMENT="local"
# Host/server identity reported with each event (defaults to the service name).
BOILERPLATE_OBSERVABILITY.SENTRY.SERVER_NAME="boilerplate"
BOILERPLATE_OBSERVABILITY.SENTRY.ENABLE_TRACING="true"
# 1.0 in local development; lower (e.g. 0.1) before production.
BOILERPLATE_OBSERVABILITY.SENTRY.TRACES_SAMPLE_RATE="1.0"
BOILERPLATE_OBSERVABILITY.SENTRY.DEBUG_LOGGING="false"
# Keeps request bodies/URLs out of Sentry.
BOILERPLATE_OBSERVABILITY.SENTRY.SEND_DEFAULT_PII="false"

# ============================================================================
# HEALTH CHECKS CONFIGURATION
# ============================================================================

# Health Check Settings
BOILERPLATE_OBSERVABILITY.HEALTH_CHECKS.ENABLED="true"
BOILERPLATE_OBSERVABILITY.HEALTH_CHECKS.INTERVAL="30s"
BOILERPLATE_OBSERVABILITY.HEALTH_CHECKS.TIMEOUT="5s"
BOILERPLATE_OBSERVABILITY.HEALTH_CHECKS.CHECKS="database,redis"

# Admin Dashboard (asynqmon)
BOILERPLATE_ADMIN.TOKEN=""