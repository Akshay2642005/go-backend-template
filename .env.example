BOILERPLATE_PRIMARY__ENV="local"

BOILERPLATE_SERVER__PORT="8080"
BOILERPLATE_SERVER__READ_TIMEOUT="30"
BOILERPLATE_SERVER__WRITE_TIMEOUT="30"
BOILERPLATE_SERVER__IDLE_TIMEOUT="60"
BOILERPLATE_SERVER__CORS_ALLOWED_ORIGINS="http://localhost:3000"
BOILERPLATE_SERVER__SHUTDOWN_TIMEOUT="30"
BOILERPLATE_SERVER__DRAIN_TIMEOUT="15"
BOILERPLATE_SERVER__COMPRESSION="true"
BOILERPLATE_SERVER__REQUEST_TIMEOUT="10"
BOILERPLATE_SERVER__SECURITY_HSTS="0"

# Rate Limiting (Redis-backed sliding window, disabled by default for local dev)
BOILERPLATE_SERVER__RATE_LIMIT__ENABLED="false"
BOILERPLATE_SERVER__RATE_LIMIT__WINDOW="60s"
BOILERPLATE_SERVER__RATE_LIMIT__MAX="100"
BOILERPLATE_SERVER__RATE_LIMIT__KEY_PREFIX="ratelimit:"
BOILERPLATE_SERVER__RATE_LIMIT__BY_USER="false"

# Idempotency (Redis-backed, disabled by default for local dev)
BOILERPLATE_SERVER__IDEMPOTENCY__ENABLED="false"
BOILERPLATE_SERVER__IDEMPOTENCY__TTL="24h"
BOILERPLATE_SERVER__IDEMPOTENCY__KEY_PREFIX="idemp:"

# Request/Response Body Logging (disabled by default, truncates at 1 KB)
BOILERPLATE_SERVER__REQUEST_BODY_LOG="false"

BOILERPLATE_DATABASE__HOST="localhost"
BOILERPLATE_DATABASE__PORT="5432"
BOILERPLATE_DATABASE__USER="postgres"
BOILERPLATE_DATABASE__PASSWORD="postgres"
BOILERPLATE_DATABASE__NAME="boilerplate"
BOILERPLATE_DATABASE__SSL_MODE="disable"
BOILERPLATE_DATABASE__MAX_OPEN_CONNS="25"
BOILERPLATE_DATABASE__MAX_IDLE_CONNS="25"
BOILERPLATE_DATABASE__CONN_MAX_LIFETIME="300"
BOILERPLATE_DATABASE__CONN_MAX_IDLE_TIME="300"
BOILERPLATE_DATABASE__AUTO_MIGRATE="false"
BOILERPLATE_DATABASE__CONNECT_RETRIES="3"
BOILERPLATE_DATABASE__CONNECT_RETRY_DELAY="2"

# Single-string DSN for CLI tooling (tern via `task migrations:up`).
# The app builds its own DSN from the fields above; koanf ignores this key.
BOILERPLATE_DB_DSN="postgres://postgres:postgres@localhost:5432/boilerplate?sslmode=disable"

BOILERPLATE_AUTH__SECRET_KEY="secret"

BOILERPLATE_INTEGRATION__RESEND_API_KEY="resend_key"

# ============================================================================
# REDIS CONFIGURATION
# ============================================================================

# Connection
BOILERPLATE_REDIS__ADDRESS="localhost:6379"
# Mode: single | cluster | sentinel
BOILERPLATE_REDIS__MODE="single"
BOILERPLATE_REDIS__USERNAME=""
BOILERPLATE_REDIS__PASSWORD=""
BOILERPLATE_REDIS__DB="0"

# TLS (required for Redis Cloud, Upstash, ElastiCache in-transit, etc.)
BOILERPLATE_REDIS__TLS_ENABLED="false"
BOILERPLATE_REDIS__TLS_SKIP_VERIFY="false"

# Connection pool
BOILERPLATE_REDIS__POOL_SIZE="10"
BOILERPLATE_REDIS__MIN_IDLE_CONNS="5"

# Timeouts
BOILERPLATE_REDIS__DIAL_TIMEOUT="5s"
BOILERPLATE_REDIS__READ_TIMEOUT="3s"
BOILERPLATE_REDIS__WRITE_TIMEOUT="3s"

# Retry
BOILERPLATE_REDIS__MAX_RETRIES="3"
BOILERPLATE_REDIS__MIN_RETRY_BACKOFF="100ms"
BOILERPLATE_REDIS__MAX_RETRY_BACKOFF="3s"

# Cache key prefix and default TTL
BOILERPLATE_REDIS__KEY_PREFIX=""
BOILERPLATE_REDIS__DEFAULT_TTL="5m"

# ============================================================================
# OBSERVABILITY CONFIGURATION
# ============================================================================

# Service Identity
BOILERPLATE_OBSERVABILITY__SERVICE_NAME="boilerplate"
BOILERPLATE_OBSERVABILITY__ENVIRONMENT="local"

# ============================================================================
# LOGGING CONFIGURATION
# ============================================================================

# Basic Logging Settings
BOILERPLATE_OBSERVABILITY__LOGGING__LEVEL="debug"
BOILERPLATE_OBSERVABILITY__LOGGING__FORMAT="console"
BOILERPLATE_OBSERVABILITY__LOGGING__SLOW_QUERY_THRESHOLD="100ms"

# ============================================================================
# OPENTELEMETRY TRACING
# ============================================================================

BOILERPLATE_OBSERVABILITY__TRACING__ENABLED="false"
BOILERPLATE_OBSERVABILITY__TRACING__ENDPOINT="localhost:4317"
BOILERPLATE_OBSERVABILITY__TRACING__SAMPLE_RATE="1.0"
BOILERPLATE_OBSERVABILITY__TRACING__INSECURE="true"

# ============================================================================
# OPENTELEMETRY METRICS
# ============================================================================

BOILERPLATE_OBSERVABILITY__METRICS__ENABLED="false"
BOILERPLATE_OBSERVABILITY__METRICS__ENDPOINT="localhost:4317"
BOILERPLATE_OBSERVABILITY__METRICS__INTERVAL="15s"
BOILERPLATE_OBSERVABILITY__METRICS__INSECURE="true"

# ============================================================================
# HEALTH CHECKS CONFIGURATION
# ============================================================================

# Health Check Settings
BOILERPLATE_OBSERVABILITY__HEALTH_CHECKS__ENABLED="true"
BOILERPLATE_OBSERVABILITY__HEALTH_CHECKS__INTERVAL="30s"
BOILERPLATE_OBSERVABILITY__HEALTH_CHECKS__TIMEOUT="5s"
BOILERPLATE_OBSERVABILITY__HEALTH_CHECKS__CHECKS="database,redis"
